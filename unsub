      font-size:11px; font-weight:500; background:#ff0000;
      color:#fff; border-radius:20px; padding:2px 8px;
    }
    .ytus-close {
      background:none; border:none; color:#aaa; font-size:20px;
      cursor:pointer; padding:4px 6px; border-radius:6px;
      transition:color .1s,background .1s; line-height:1;
    }
    .ytus-close:hover { color:#fff; background:#272727; }

    .ytus-tabs {
      display:flex; border-bottom:1px solid #272727;
      background:#161616; flex-shrink:0;
    }
    .ytus-tab {
