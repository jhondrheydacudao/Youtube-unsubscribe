    #ytus-bd {
      position:fixed; inset:0; z-index:2147483645;
      background:rgba(0,0,0,.75); backdrop-filter:blur(3px); display:none;
    }
    #ytus-bd.ytus-open { display:block; }
  `);

  // ═══════════════════════════════════════════════════════════════════════════
  //  UI
  // ═══════════════════════════════════════════════════════════════════════════
  let currentTab = 'channels';
  let panel      = null;

  function ensurePanel() {
    if (!document.getElementById('ytus-bd')) {
      const bd = document.createElement('div');
      bd.id = 'ytus-bd';
      bd.addEventListener('click', closePanel);
      document.body.appendChild(bd);
    }
    if (document.getElementById(PANEL_ID)) { panel = document.getElementById(PANEL_ID); return; }

    panel = document.createElement('div');
    panel.id = PANEL_ID;
    panel.innerHTML = `
      <div class="ytus-header">
        <div class="ytus-title">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#ff2222"
               stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42A2.78 2.78 0 0020.83 4.7C19.24 4.27 12 4.27 12 4.27
                     s-7.24 0-8.83.43A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0
                     00.46 5.58A2.78 2.78 0 003.17 19.3C4.76 19.73 12 19.73 12 19.73
                     s7.24 0 8.83-.43a2.78 2.78 0 001.71-1.72A29 29 0 0023 12a29 29
                     0 00-.46-5.58z"/>
            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
          </svg>
          YouTube Unsubscriber
          <span class="ytus-pill">v4.0</span>
        </div>
        <button class="ytus-close" id="ytus-x">✕</button>
      </div>
      <div class="ytus-tabs">
        <button class="ytus-tab active" data-tab="channels">Channels</button>
        <button class="ytus-tab" data-tab="log">Log</button>
        <button class="ytus-tab" data-tab="settings">Settings</button>
      </div>
      <div class="ytus-body" id="ytus-body"></div>
      <div class="ytus-footer" id="ytus-footer"></div>
    `;
    document.body.appendChild(panel);

    panel.querySelector('#ytus-x').addEventListener('click', closePanel);
    panel.querySelectorAll('.ytus-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        currentTab = tab.dataset.tab;
        panel.querySelectorAll('.ytus-tab').forEach(t => t.classList.toggle('active', t === tab));
        renderBody();
      });
    });
  }

  function renderBody() {
    const body   = document.getElementById('ytus-body');
    const footer = document.getElementById('ytus-footer');
    if (!body || !footer) return;
    if      (currentTab === 'channels') renderChannels(body, footer);
    else if (currentTab === 'log')      renderLogTab(body, footer);
    else if (currentTab === 'settings') renderSettings(body, footer);
  }

  // ── Channels tab ─────────────────────────────────────────────────────────────
  function renderChannels(body, footer) {
    const filtered = state.channels.filter(ch =>
      ch.name.toLowerCase().includes(state.filterText.toLowerCase())
    );

    const banner = state.running ? `
      <div class="ytus-banner">
        <div class="ytus-spinner"></div>
        Processing ${state.progress.done} / ${state.progress.total} — stay on youtube.com
      </div>` : '';

    body.innerHTML = `
      ${banner}
      <div class="ytus-toolbar">
        <input class="ytus-search" id="ytus-search"
               placeholder="Filter channels…" value="${escHtml(state.filterText)}">
        <button class="ytus-btn" id="ytus-scan" ${state.running ? 'disabled' : ''}>↻ Scan</button>
        <button class="ytus-btn" id="ytus-all"  ${state.running ? 'disabled' : ''}>All</button>
        <button class="ytus-btn" id="ytus-none" ${state.running ? 'disabled' : ''}>None</button>
      </div>
      ${filtered.length === 0 ? `
        <div class="ytus-empty">
          <div class="ytus-empty-icon">📭</div>
          <div class="ytus-empty-title">
            ${state.channels.length === 0 ? 'Nothing scanned yet' : 'No channels match'}
          </div>
          <div class="ytus-empty-sub">
            ${state.channels.length === 0
              ? `Go to <a href="https://www.youtube.com/feed/channels" target="_blank">
                   youtube.com/feed/channels
                 </a>, scroll to load all channels, then click <strong>↻ Scan</strong>.`
              : 'Try a different filter.'}
          </div>
        </div>
      ` : `
        <ul class="ytus-channel-list">
          ${filtered.map(ch => chHTML(ch)).join('')}
        </ul>
      `}
    `;

    // Footer
    const total = state.selected.size;
    if (state.running) {
      const pct = state.progress.total > 0
        ? Math.round((state.progress.done / state.progress.total) * 100) : 0;
      footer.innerHTML = `
        <span class="ytus-prog-label">${state.progress.done}/${state.progress.total}</span>
        <div class="ytus-prog-wrap">
          <div class="ytus-prog-bar" style="width:${pct}%"></div>
        </div>
        <button class="ytus-btn" id="ytus-pause">
          ${state.paused ? '▶ Resume' : '⏸ Pause'}
        </button>
        <button class="ytus-btn danger" id="ytus-stop">■ Stop</button>
      `;
      footer.querySelector('#ytus-pause').addEventListener('click', togglePause);
      footer.querySelector('#ytus-stop').addEventListener('click', stopRun);
    } else {
      footer.innerHTML = `
        <span class="ytus-sel-count">
          <strong>${total}</strong> channel${total !== 1 ? 's' : ''} selected
        </span>
        <button class="ytus-btn" id="ytus-inv">Invert</button>
        <button class="ytus-btn primary" id="ytus-run" ${total === 0 ? 'disabled' : ''}>
          Unsubscribe${total > 0 ? ' ' + total : ''} →
        </button>
      `;
      footer.querySelector('#ytus-inv')?.addEventListener('click', invertSelection);
      footer.querySelector('#ytus-run')?.addEventListener('click', runUnsubscribe);
    }

    // Events
    body.querySelector('#ytus-search')?.addEventListener('input', e => {
      state.filterText = e.target.value;
      renderBody();
    });
    body.querySelector('#ytus-scan')?.addEventListener('click', scanChannels);
    body.querySelector('#ytus-all')?.addEventListener('click', () => {
      filtered.forEach(ch => state.selected.add(ch.id));
      renderBody();
    });
    body.querySelector('#ytus-none')?.addEventListener('click', () => {
      filtered.forEach(ch => state.selected.delete(ch.id));
      renderBody();
    });
    body.querySelectorAll('.ytus-channel-item').forEach(item => {
      item.addEventListener('click', () => {
        if (state.running) return;
        const id = item.dataset.id;
        if (state.selected.has(id)) state.selected.delete(id);
        else state.selected.add(id);
        item.classList.toggle('selected', state.selected.has(id));
        syncFooterCount();
      });
    });
  }

  function chHTML(ch) {
    const sel     = state.selected.has(ch.id);
    const initial = ch.name.charAt(0).toUpperCase();
    const avatar  = ch.avatar
      ? `<img class="ytus-avatar" src="${escHtml(ch.avatar)}" alt="" onerror="this.style.display='none'">`
      : `<div class="ytus-avatar-ph">${initial}</div>`;
    const badge = ch.status === 'done'
      ? '<span class="ytus-badge done">✓ Done</span>'
      : ch.status === 'failed'
      ? '<span class="ytus-badge failed">✗ Failed</span>'
      : '';
    return `
      <li class="ytus-channel-item${sel ? ' selected' : ''}${ch.status ? ' ' + ch.status : ''}"
          data-id="${escHtml(ch.id)}">
        <div class="ytus-check"><span class="ytus-check-tick">✓</span></div>
        ${avatar}
        <div class="ytus-ch-info">
          <div class="ytus-ch-name">${escHtml(ch.name)}</div>
          <div class="ytus-ch-sub">${escHtml(safePathname(ch.url))}</div>
        </div>
        ${badge}
      </li>`;
  }

  function syncFooterCount() {
    const el = document.querySelector('.ytus-sel-count strong');
    if (el) el.textContent = state.selected.size;
    const btn = document.getElementById('ytus-run');
    if (btn) {
      btn.disabled    = state.selected.size === 0;
      btn.textContent = `Unsubscribe${state.selected.size > 0 ? ' ' + state.selected.size : ''} →`;
    }
  }

  // ── Log tab ───────────────────────────────────────────────────────────────────
  function renderLogTab(body, footer) {
    body.innerHTML = `<div class="ytus-log" id="ytus-log-inner">
      ${state.log.length === 0
        ? '<div style="color:#444;text-align:center;padding:40px 0">No log entries yet.</div>'
        : state.log.map(e =>
            `<div class="ytus-log-line ${e.type}">[${e.ts}] ${escHtml(e.msg)}</div>`
          ).join('')
      }
    </div>`;
    footer.innerHTML = `<button class="ytus-btn" id="ytus-clrlog">Clear</button>`;
    footer.querySelector('#ytus-clrlog').addEventListener('click', () => {
      state.log = []; renderBody();
    });
  }

  function renderLog() {
    if (currentTab !== 'log') return;
    const el = document.getElementById('ytus-log-inner');
    if (el) el.innerHTML = state.log.map(e =>
      `<div class="ytus-log-line ${e.type}">[${e.ts}] ${escHtml(e.msg)}</div>`
    ).join('');
  }

  // ── Settings tab ──────────────────────────────────────────────────────────────
  function renderSettings(body, footer) {
    body.innerHTML = `
      <div class="ytus-section">
        <div class="ytus-section-label">Speed</div>
        <div class="ytus-row">
          <label>Delay between requests</label>
          <input type="range" class="ytus-range" id="ytus-delay"
                 min="500" max="5000" step="100" value="${state.delay}">
          <span class="ytus-range-val" id="ytus-dval">${(state.delay/1000).toFixed(1)}s</span>
        </div>
      </div>
      <div class="ytus-infobox">
        <strong>How it works (v4 — API mode)</strong><br>
        This version calls YouTube's internal unsubscribe API directly — <em>no page navigation</em>.<br><br>
        1. Go to <a href="https://www.youtube.com/feed/channels" target="_blank">youtube.com/feed/channels</a>
           and scroll to load all subscriptions<br>
        2. Open this panel and click <strong>↻ Scan</strong><br>
        3. Select channels (or click <strong>All</strong>)<br>
        4. Click <strong>Unsubscribe →</strong> — all channels are processed right here,
           no tab navigation needed<br><br>
        <strong>Delay ≥ 1 s</strong> is recommended to stay under YouTube's rate limits.
      </div>
    `;
    footer.innerHTML = `<span class="ytus-sel-count" style="color:#444">Settings auto-save</span>`;
    body.querySelector('#ytus-delay').addEventListener('input', e => {
      state.delay = parseInt(e.target.value);
      body.querySelector('#ytus-dval').textContent = (state.delay/1000).toFixed(1) + 's';
      _gmSet('delay', state.delay);
    });
  }

  // ── Open / Close ──────────────────────────────────────────────────────────────
  function openPanel() {
    ensurePanel();
    document.getElementById('ytus-bd').classList.add('ytus-open');
    panel.classList.add('ytus-open');
    currentTab = 'channels';
    panel.querySelectorAll('.ytus-tab').forEach(t =>
      t.classList.toggle('active', t.dataset.tab === 'channels')
    );
    if (state.channels.length === 0 && !state.running) scanChannels();
    else renderBody();
  }

  function closePanel() {
    document.getElementById('ytus-bd')?.classList.remove('ytus-open');
    document.getElementById(PANEL_ID)?.classList.remove('ytus-open');
  }

  // ── FAB ───────────────────────────────────────────────────────────────────────
  function createFAB() {
    if (document.getElementById('ytus-fab')) return;
    const fab = document.createElement('button');
    fab.id    = 'ytus-fab';
    fab.title = 'YouTube Bulk Unsubscriber (Alt+U)';
    fab.innerHTML = `
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6l-1 14H6L5 6"/>
        <path d="M10 11v6M14 11v6"/>
        <path d="M9 6V4h6v2"/>
      </svg>`;
    fab.addEventListener('click', openPanel);
    document.body.appendChild(fab);
  }

  // ── Alt+U shortcut ────────────────────────────────────────────────────────────
  document.addEventListener('keydown', e => {
    if (e.altKey && e.key === 'u') {
      const p = document.getElementById(PANEL_ID);
      if (!p || !p.classList.contains('ytus-open')) openPanel();
      else closePanel();
    }
  });

  // ── Init ──────────────────────────────────────────────────────────────────────
  function init() {
    createFAB();
    addLog('YouTube Unsubscriber v4.0 ready (API mode). Press Alt+U or click the red button.', 'info');
  }

  if (document.body) init();
  else document.addEventListener('DOMContentLoaded', init);

  // Recreate FAB after SPA navigations
  let _lastUrl = location.href;
  new MutationObserver(() => {
    if (location.href !== _lastUrl) {
      _lastUrl = location.href;
      setTimeout(createFAB, 1200);
    }
  }).observe(document.body, { childList: true, subtree: true });

})();
