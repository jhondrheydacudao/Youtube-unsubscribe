// ==UserScript==
// @name         YouTube Bulk Unsubscriber
// @namespace    https://github.com/youtube-unsubscriber
// @version      3.0.0
// @description  Scan, select, and bulk unsubscribe from YouTube channels – works to completion
// @author       UserScript
// @match        https://www.youtube.com/*
// @grant        GM_addStyle
// @grant        GM_setValue
// @grant        GM_getValue
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  // ─── GM shims ────────────────────────────────────────────────────────────────
  const _gmStyle = typeof GM_addStyle === 'function'
    ? GM_addStyle
    : css => { const s = document.createElement('style'); s.textContent = css; document.head.appendChild(s); };
  const _gmSet = typeof GM_setValue === 'function'
    ? GM_setValue
    : (k, v) => { try { localStorage.setItem('ytus_' + k, JSON.stringify(v)); } catch {} };
  const _gmGet = typeof GM_getValue === 'function'
    ? GM_getValue
    : (k, d) => { try { const r = localStorage.getItem('ytus_' + k); return r === null ? d : JSON.parse(r); } catch { return d; } };

  // ─── Constants ───────────────────────────────────────────────────────────────
  const PANEL_ID   = 'ytus-panel';
  const QUEUE_KEY  = 'ytus_queue';   // sessionStorage – survives navigation within tab
  const RESULT_KEY = 'ytus_results'; // sessionStorage

  // ─── Helpers ─────────────────────────────────────────────────────────────────
  const sleep  = ms => new Promise(r => setTimeout(r, ms));
  const rand   = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;

  function escHtml(s) {
    return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function safePathname(url) {
    try { return new URL(url).pathname; } catch { return url || ''; }
  }

  // ─── Persistent queue (survives page navigation) ──────────────────────────────
  function queueGet()        { try { return JSON.parse(sessionStorage.getItem(QUEUE_KEY)  || 'null'); } catch { return null; } }
  function queueSet(q)       { sessionStorage.setItem(QUEUE_KEY,  JSON.stringify(q)); }
  function queueClear()      { sessionStorage.removeItem(QUEUE_KEY); }
  function resultsGet()      { try { return JSON.parse(sessionStorage.getItem(RESULT_KEY) || '[]'); } catch { return []; } }
  function resultsAdd(entry) { const r = resultsGet(); r.push(entry); sessionStorage.setItem(RESULT_KEY, JSON.stringify(r)); }
  function resultsClear()    { sessionStorage.removeItem(RESULT_KEY); }

  // ─── State ───────────────────────────────────────────────────────────────────
  let state = {
    channels:    [],
    selected:    new Set(),
    running:     false,
    paused:      false,
    progress:    { done: 0, total: 0 },
    log:         [],
    filterText:  '',
    delay:       _gmGet('delay', 2000),
  };

  // ─── Styles ──────────────────────────────────────────────────────────────────
  _gmStyle(`
