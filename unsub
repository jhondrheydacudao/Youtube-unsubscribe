// ==UserScript==
// @name         YouTube Bulk Unsubscriber
// @namespace    https://github.com/youtube-unsubscriber
// @version      4.0.0
// @description  Bulk unsubscribe from YouTube channels using YouTube's own internal API — no page navigation required
// @author       UserScript
// @match        https://www.youtube.com/*
// @grant        GM_addStyle
// @grant        GM_setValue
// @grant        GM_getValue
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  // ─── GM shims ────────────────────────────────────────────────────────────────
  const _gmStyle = typeof GM_addStyle === 'function'
    ? GM_addStyle
    : css => { const s = document.createElement('style'); s.textContent = css; document.head.appendChild(s); };
  const _gmSet = typeof GM_setValue === 'function'
    ? GM_setValue
    : (k, v) => { try { localStorage.setItem('ytus_' + k, JSON.stringify(v)); } catch {} };
  const _gmGet = typeof GM_getValue === 'function'
    ? GM_getValue
    : (k, d) => { try { const r = localStorage.getItem('ytus_' + k); return r === null ? d : JSON.parse(r); } catch { return d; } };

  // ─── Constants ───────────────────────────────────────────────────────────────
  const PANEL_ID = 'ytus-panel';

  // ─── Helpers ─────────────────────────────────────────────────────────────────
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  const rand  = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;

  function escHtml(s) {
    return String(s)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function safePathname(url) {
    try { return new URL(url).pathname; } catch { return url || ''; }
  }

  // ─── State ───────────────────────────────────────────────────────────────────
  let state = {
    channels:   [],   // { id, name, url, avatar, channelId, status }
    selected:   new Set(),
    running:    false,
    paused:     false,
    progress:   { done: 0, total: 0 },
    log:        [],
    filterText: '',
    delay:      _gmGet('delay', 1500),
  };

  // ═══════════════════════════════════════════════════════════════════════════
  //  YOUTUBE INTERNAL API
  //  We extract the same auth tokens YouTube's own front-end uses, then call
  //  /youtubei/v1/subscription/unsubscribe directly.  No page navigation ever.
  // ═══════════════════════════════════════════════════════════════════════════

  // Extract ytcfg / INNERTUBE tokens from the page
  function getInnertube() {
    try {
      const cfg = window.ytcfg?.data_ || {};
      const apiKey       = cfg.INNERTUBE_API_KEY       || cfg.innertubeApiKey || '';
      const clientName   = cfg.INNERTUBE_CLIENT_NAME   || 'WEB';
      const clientVer    = cfg.INNERTUBE_CLIENT_VERSION || '2.20240101.00.00';
      const visitorData  = cfg.VISITOR_DATA            || cfg.visitorData || '';
      const authUser     = cfg.SESSION_INDEX            || '0';

      // SAPISID cookie for SAPISIDHASH
      const sapisid = document.cookie.split(';')
        .map(c => c.trim())
        .find(c => c.startsWith('SAPISID=') || c.startsWith('__Secure-3PAPISID='));
      const sapisidVal = sapisid ? sapisid.split('=')[1] : null;

      return { apiKey, clientName, clientVer, visitorData, authUser, sapisidVal };
    } catch (e) {
      return null;
    }
  }

  // Build SAPISIDHASH authorization header
  function buildAuthHeader(sapisidVal) {
    // YouTube computes: SHA-1(timestamp + " " + SAPISID + " " + origin)
    // We can't do SHA-1 in pure JS without SubtleCrypto, but we CAN rely on
    // the browser's existing cookies — fetch() will send them automatically,
    // and YouTube accepts requests without the SAPISIDHASH header when the
    // request comes from the same origin (which it does via fetch).
    return null; // not needed; cookies handle auth
  }

  // Call YouTube's unsubscribe API endpoint
  async function apiUnsubscribe(channelId) {
    const it = getInnertube();
    if (!it || !it.apiKey) throw new Error('Could not read Innertube config');

    const url = `https://www.youtube.com/youtubei/v1/subscription/unsubscribe?key=${it.apiKey}&prettyPrint=false`;

    const body = {
      context: {
        client: {
          clientName:    it.clientName,
          clientVersion: it.clientVer,
          visitorData:   it.visitorData,
          hl: navigator.language || 'en',
          gl: 'US',
        },
      },
      channelIds: [channelId],
    };

    const headers = {
      'Content-Type':         'application/json',
      'X-YouTube-Client-Name':    '1',
      'X-YouTube-Client-Version': it.clientVer,
      'X-Goog-AuthUser':          it.authUser,
      'X-Origin':                 'https://www.youtube.com',
    };

    const resp = await fetch(url, {
      method:      'POST',
      headers,
      body:        JSON.stringify(body),
      credentials: 'include',   // sends cookies (session auth)
    });

    if (!resp.ok) {
      const text = await resp.text().catch(() => resp.status);
      throw new Error(`API ${resp.status}: ${String(text).slice(0, 120)}`);
    }

    const json = await resp.json().catch(() => ({}));
    // Success response has no error field; check explicitly
    if (json.error) throw new Error(json.error.message || JSON.stringify(json.error));
    return true;
  }

  // ─── Extract channelId from a channel URL or page DOM ────────────────────────
  // channelId must be the UC… form for the API
  async function resolveChannelId(channel) {
    // Already have it
    if (channel.channelId && channel.channelId.startsWith('UC')) return channel.channelId;

    // Try to parse from URL: /channel/UCxxxxxx
    const m = (channel.url || '').match(/\/channel\/(UC[\w-]+)/);
    if (m) return m[1];

    // For /@handle or /c/name URLs we need to fetch the channel page and extract it
    if (!channel.url) return null;

    try {
      const resp = await fetch(channel.url, { credentials: 'include' });
      const text = await resp.text();

      // Look for "channelId":"UCxxxxxx" in the page source
      const match = text.match(/"channelId"\s*:\s*"(UC[\w-]+)"/);
      if (match) return match[1];

      // Also try externalId
      const match2 = text.match(/"externalId"\s*:\s*"(UC[\w-]+)"/);
      if (match2) return match2[1];
    } catch {}

    return null;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  //  CHANNEL SCRAPING
  // ═══════════════════════════════════════════════════════════════════════════

  function scrapeChannels() {
    const channels = [];
    const seen     = new Set();

    // ── Primary: /feed/channels page ──────────────────────────────────────────
    document.querySelectorAll('ytd-channel-renderer').forEach(el => {
      try {
        const nameEl   = el.querySelector('#channel-title, yt-formatted-string#text, #text');
        const avatarEl = el.querySelector('yt-img-shadow img, img#img, img');
        const linkEl   = el.querySelector('a#main-link, a#channel-title, a');
        if (!nameEl) return;

        const name = nameEl.textContent.trim();
        if (!name || seen.has(name)) return;
        seen.add(name);

        const href      = linkEl?.href || '';
        // Try to grab channelId from the element's data
        const chanMatch = href.match(/\/channel\/(UC[\w-]+)/);
        const channelId = chanMatch ? chanMatch[1] : null;

        // Also try ytInitialData embedded in the renderer
        let embeddedId = null;
        try {
          const raw = el.closest('[data-context-item-id]')?.dataset?.contextItemId;
          if (raw && raw.startsWith('UC')) embeddedId = raw;
        } catch {}

        channels.push({
          id:        (href || name).replace(/[^\w@/-]/g, '_').slice(0, 120),
          name,
          avatar:    avatarEl?.src || '',
          url:       href,
          channelId: channelId || embeddedId || null,
          status:    null,
        });
      } catch {}
    });

    // ── Fallback: extract from window.ytInitialData ───────────────────────────
    if (channels.length === 0) {
      try {
        const initData = window.ytInitialData;
        const tabs = initData?.contents?.twoColumnBrowseResultsRenderer?.tabs;
        if (tabs) {
          tabs.forEach(tab => {
            const items = tab?.tabRenderer?.content?.sectionListRenderer?.contents || [];
            items.forEach(section => {
              const itemSection = section?.itemSectionRenderer?.contents || [];
              itemSection.forEach(item => {
                const renderer = item?.channelRenderer;
                if (!renderer) return;
                const name      = renderer.title?.simpleText || renderer.displayName?.simpleText || '';
                const channelId = renderer.channelId || null;
                const url       = 'https://www.youtube.com/channel/' + channelId;
                const avatar    = renderer.thumbnail?.thumbnails?.[0]?.url || '';
                if (!name || seen.has(name)) return;
                seen.add(name);
                channels.push({
                  id: (channelId || name).replace(/[^\w@/-]/g, '_').slice(0, 120),
                  name, avatar, url, channelId, status: null,
                });
              });
            });
          });
        }
      } catch {}
    }

    // ── Fallback: sidebar guide entries ───────────────────────────────────────
    if (channels.length === 0) {
      document.querySelectorAll('ytd-guide-entry-renderer').forEach(el => {
        try {
          const nameEl = el.querySelector('#title, yt-formatted-string#title, #guide-entry-title');
          if (!nameEl) return;
          const name = nameEl.textContent.trim();
          if (!name || name.length < 2 || seen.has(name)) return;
          const linkEl = el.querySelector('a');
          const href   = linkEl?.href || '';
          if (!href.includes('/channel') && !href.includes('/@') && !href.includes('/c/')) return;
          seen.add(name);
          const chanMatch = href.match(/\/channel\/(UC[\w-]+)/);
          channels.push({
            id:        (href || name).replace(/[^\w@/-]/g, '_').slice(0, 120),
            name,
            avatar:    el.querySelector('img')?.src || '',
            url:       href,
            channelId: chanMatch ? chanMatch[1] : null,
            status:    null,
          });
        } catch {}
      });
    }

    return channels;
  }

  // ═══════════════════════════════════════════════════════════════════════════
  //  BULK UNSUBSCRIBE ENGINE  (no navigation — pure API calls)
  // ═══════════════════════════════════════════════════════════════════════════

  async function runUnsubscribe() {
    if (state.running) return;

    const toProcess = state.channels.filter(
      ch => state.selected.has(ch.id) && ch.status !== 'done'
    );
    if (!toProcess.length) return;

    // Verify we can read Innertube config before starting
    if (!getInnertube()?.apiKey) {
      addLog('❌ Cannot read YouTube session tokens. Make sure you are logged in and on youtube.com.', 'err');
      return;
    }

    state.running  = true;
    state.paused   = false;
    state.progress = { done: 0, total: toProcess.length };
    addLog(`Starting bulk unsubscribe for ${toProcess.length} channel(s)…`, 'info');
    renderBody();

    for (let i = 0; i < toProcess.length; i++) {
      if (!state.running) break;
      while (state.paused) await sleep(300);

      const ch = toProcess[i];
      state.progress.done = i;
      addLog(`[${i + 1}/${toProcess.length}] Resolving ${ch.name}…`, 'info');
      renderBody();

      let success = false;
      try {
        // Resolve UC… channelId if we don't have it yet
        let channelId = ch.channelId;
        if (!channelId || !channelId.startsWith('UC')) {
          channelId = await resolveChannelId(ch);
          if (channelId) ch.channelId = channelId;
        }

        if (!channelId) {
          addLog(`✗ Could not resolve channel ID for ${ch.name} — skipped`, 'err');
        } else {
          addLog(`  → ID: ${channelId} — calling unsubscribe API…`, 'info');
          await apiUnsubscribe(channelId);
          success = true;
        }
      } catch (e) {
        addLog(`✗ Error on ${ch.name}: ${e.message}`, 'err');
      }

      ch.status = success ? 'done' : 'failed';
      if (success) {
        state.selected.delete(ch.id);
        addLog(`✓ Unsubscribed from ${ch.name}`, 'ok');
      } else {
        addLog(`✗ Failed: ${ch.name}`, 'err');
      }

      state.progress.done = i + 1;
      renderBody();

      // Delay before next request (avoid rate-limiting)
      if (i < toProcess.length - 1 && state.running) {
        const d = rand(state.delay - 300, state.delay + 500);
        addLog(`  ⏱ Waiting ${(d / 1000).toFixed(1)}s…`, 'info');
        await sleep(d);
      }
    }

    state.running = false;
    state.paused  = false;
    const doneCount = toProcess.filter(ch => ch.status === 'done').length;
    const failCount = toProcess.filter(ch => ch.status === 'failed').length;
    addLog(`✅ Complete! ${doneCount} unsubscribed, ${failCount} failed.`, 'ok');
    renderBody();
  }

  function togglePause() {
    state.paused = !state.paused;
    addLog(state.paused ? '⏸ Paused.' : '▶ Resumed.', 'info');
    renderBody();
  }

  function stopRun() {
    state.running = false;
    state.paused  = false;
    addLog('■ Stopped by user.', 'info');
    renderBody();
  }

  function invertSelection() {
    state.channels
      .filter(ch => ch.name.toLowerCase().includes(state.filterText.toLowerCase()))
      .forEach(ch => {
        if (state.selected.has(ch.id)) state.selected.delete(ch.id);
        else state.selected.add(ch.id);
      });
    renderBody();
  }

  function scanChannels() {
    addLog('Scanning page for subscriptions…', 'info');
    const found      = scrapeChannels();
    const existing   = Object.fromEntries(state.channels.map(c => [c.id, c]));
    state.channels   = found.map(c => ({
      ...c,
      channelId: c.channelId || existing[c.id]?.channelId || null,
      status:    existing[c.id]?.status ?? null,
    }));
    if (state.channels.length === 0) {
      addLog('No channels found. Go to youtube.com/feed/channels first, then scroll to load all.', 'err');
    } else {
      addLog(`Found ${state.channels.length} channel(s).`, 'ok');
    }
    renderBody();
  }

  // ─── Log ─────────────────────────────────────────────────────────────────────
  function addLog(msg, type = 'info') {
    state.log.unshift({ msg, type, ts: new Date().toLocaleTimeString() });
    if (state.log.length > 400) state.log.pop();
    renderLog();
  }

