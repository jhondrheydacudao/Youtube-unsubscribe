    .ytus-info-box {
      margin:0 20px 20px; background:#1a1a1a; border:1px solid #272727;
      border-radius:8px; padding:12px 14px; font-size:12px; color:#888; line-height:1.7;
    }
    .ytus-info-box a { color:#ff6666; text-decoration:none; }
    .ytus-info-box strong { color:#ccc; }

    .ytus-log-wrap {
      padding:10px 14px; font-size:12px;
      font-family:'Roboto Mono',monospace; color:#888;
    }
    .ytus-log-entry { padding:3px 0; border-bottom:1px solid #1a1a1a; word-break:break-all; }
    .ytus-log-entry.ok   { color:#4caf50; }
    .ytus-log-entry.err  { color:#f44336; }
    .ytus-log-entry.info { color:#888; }

    #ytus-backdrop {
      position:fixed; inset:0; z-index:99997;
