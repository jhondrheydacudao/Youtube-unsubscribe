  // ─── Log ─────────────────────────────────────────────────────────────────────
  function addLog(msg, type = 'info') {
    state.log.unshift({ msg, type, ts: new Date().toLocaleTimeString() });
    if (state.log.length > 300) state.log.pop();
    renderLog();
  }

  // ─── Channel scraping ─────────────────────────────────────────────────────────
  function scrapeChannels() {
    const channels = [];
    const seen = new Set();

    // Primary: youtube.com/feed/channels
    document.querySelectorAll('ytd-channel-renderer').forEach(el => {
      try {
        const nameEl   = el.querySelector('#channel-title, #text, yt-formatted-string#text');
        const avatarEl = el.querySelector('yt-img-shadow img, img#img');
        const linkEl   = el.querySelector('a#main-link, a#channel-title, a');
        if (!nameEl) return;
        const name = nameEl.textContent.trim();
        if (!name || seen.has(name)) return;
        seen.add(name);
        const href = linkEl?.href || '';
        channels.push({
          id:     (href || name).replace(/[^\w@/-]/g, '_').slice(0, 120),
          name, avatar: avatarEl?.src || '', url: href, status: null
        });
      } catch {}
    });

    // Fallback: sidebar guide entries
    if (channels.length === 0) {
      document.querySelectorAll('ytd-guide-entry-renderer').forEach(el => {
        try {
          const nameEl = el.querySelector('#title, yt-formatted-string#title, #guide-entry-title');
          if (!nameEl) return;
          const name = nameEl.textContent.trim();
          if (!name || name.length < 2 || seen.has(name)) return;
          const linkEl = el.querySelector('a');
          const href   = linkEl?.href || '';
          if (!href.includes('/channel') && !href.includes('/@') && !href.includes('/c/')) return;
          seen.add(name);
          const avatarEl = el.querySelector('img');
          channels.push({
            id:     (href || name).replace(/[^\w@/-]/g, '_').slice(0, 120),
            name, avatar: avatarEl?.src || '', url: href, status: null
          });
        } catch {}
      });
    }

    return channels;
  }

  // ─── Find the subscribe/subscribed button on a channel page ───────────────────
  function findSubscribeButton() {
    const selectors = [
      // 2024-2025 YouTube layout
      'ytd-channel-header-renderer yt-button-shape button',
      '#channel-header-container yt-button-shape button',
      '#subscribe-button yt-button-shape button',
      'ytd-subscribe-button-renderer yt-button-shape button',
      // Older layout
      '#subscribe-button button',
      'ytd-subscribe-button-renderer button',
      '#owner #subscribe-button button',
      // Aria fallbacks
      'button[aria-label*="Unsubscribe" i]',
      'button[aria-label*="Subscribed" i]',
    ];
    for (const sel of selectors) {
      try {
        const btn = document.querySelector(sel);
        if (btn) return btn;
      } catch {}
    }
    return null;
  }

  // ─── Click the unsubscribe confirm button in menu or dialog ──────────────────
  async function clickConfirmUnsubscribe(timeoutMs = 7000) {
    const deadline = Date.now() + timeoutMs;
    while (Date.now() < deadline) {
      // All known confirm targets
      const candidates = [
        ...document.querySelectorAll('yt-confirm-dialog-renderer #confirm-button button'),
        ...document.querySelectorAll('yt-confirm-dialog-renderer yt-button-shape button'),
        ...document.querySelectorAll('tp-yt-paper-dialog yt-button-renderer:last-child button'),
        ...document.querySelectorAll('tp-yt-paper-dialog paper-button[dialog-confirm]'),
        ...document.querySelectorAll('ytd-menu-popup-renderer ytd-menu-service-item-renderer yt-formatted-string'),
        ...document.querySelectorAll('.style-destructive button'),
        ...document.querySelectorAll('button[aria-label="Unsubscribe"]'),
        ...document.querySelectorAll('yt-button-shape button[aria-label="Unsubscribe"]'),
      ];
      for (const el of candidates) {
        const text = (el.textContent || el.getAttribute('aria-label') || '').toLowerCase();
        // Only click elements whose text specifically says "unsubscribe"
        if (text.includes('unsubscribe') && el.offsetParent !== null) {
          el.click();
          await sleep(600);
          return true;
        }
      }
      await sleep(150);
    }
    return false;
  }

  // ─── Perform unsubscribe on the current channel page ─────────────────────────
  async function performUnsubscribeOnPage() {
    // 1. Wait for subscribe button to appear (up to 12 s)
    let btn = null;
    const deadline = Date.now() + 12000;
    while (Date.now() < deadline) {
      btn = findSubscribeButton();
      if (btn) break;
      await sleep(300);
    }
    if (!btn) {
      addLog('Subscribe button not found on page.', 'err');
      return false;
    }

    const label = (btn.getAttribute('aria-label') || btn.textContent || '').toLowerCase().trim();

    // If already showing "Subscribe" (not subscribed), treat as success
    if (label === 'subscribe' || (label.includes('subscribe') && !label.includes('subscribed'))) {
      addLog('Already unsubscribed (button shows Subscribe).', 'info');
      return true;
    }

    // Click the "Subscribed" button to open the menu/dialog
    btn.click();
    await sleep(900);

    // Click confirm
    const confirmed = await clickConfirmUnsubscribe(7000);
    if (!confirmed) {
      addLog('Could not find confirm button.', 'err');
      return false;
    }

    // Verify the button flipped back to "Subscribe"
    const verifyDeadline = Date.now() + 6000;
    while (Date.now() < verifyDeadline) {
      const newBtn = findSubscribeButton();
      if (newBtn) {
        const newLabel = (newBtn.getAttribute('aria-label') || newBtn.textContent || '').toLowerCase().trim();
        if (newLabel === 'subscribe' || (newLabel.includes('subscribe') && !newLabel.includes('subscribed'))) {
          return true;
        }
      }
      await sleep(300);
    }

    // Verification timed out — YouTube may update lazily, count as done
    addLog('Verification timed out — assuming success.', 'info');
    return true;
  }

  // ─── Queue-based bulk unsubscribe engine ─────────────────────────────────────
  //
  // The queue lives in sessionStorage so it survives each page navigation.
  // Flow: build queue → navigate to ch[0].url → unsubscribe → record result
  //       → wait delay → navigate to ch[1].url → … repeat until done.
  //
  async function runUnsubscribe() {
    if (state.running) return;

    const toProcess = state.channels.filter(
      ch => state.selected.has(ch.id) && ch.status !== 'done'
    );
    if (!toProcess.length) return;

    const queue = toProcess.map(ch => ({
      id: ch.id, name: ch.name, url: ch.url, avatar: ch.avatar || ''
    }));
    queueSet({ items: queue, index: 0, delay: state.delay });
    resultsClear();

    state.running = true;
    state.paused  = false;
    state.progress = { done: 0, total: queue.length };
    addLog(`Starting bulk unsubscribe for ${queue.length} channel(s)…`, 'info');
    renderBody();

    await processBulkQueue();
  }

  async function processBulkQueue() {
    const q = queueGet();
    if (!q) { state.running = false; renderBody(); return; }

    state.progress.total = q.items.length;

    for (let i = q.index; i < q.items.length; i++) {
      // Re-read queue in case user paused/stopped then page reloaded
      if (!state.running) { queueClear(); break; }
      while (state.paused) { await sleep(400); }

      const ch = q.items[i];
      state.progress.done = i;

      // Persist current index before navigating (in case of crash)
      q.index = i;
      queueSet(q);

      if (!ch.url) {
        addLog(`✗ No URL for ${ch.name} — skipped`, 'err');
        resultsAdd({ id: ch.id, name: ch.name, status: 'failed' });
        updateChannelStatus(ch.id, 'failed');
        renderBody();
        continue;
      }

      addLog(`[${i + 1}/${q.items.length}] Going to ${ch.name}…`, 'info');
      renderBody();

      // Navigate — this kills the current JS context; init() will resume from sessionStorage
      window.location.href = ch.url;

      // The code below will NOT run after navigation.
      // Execution resumes in maybeResumeQueue() after the page reloads.
      return;
    }

    // All done (reached here if loop finishes without navigating, e.g. all skipped)
    finishRun();
  }

  function finishRun() {
    state.running = false;
    state.paused  = false;
    queueClear();
    const results    = resultsGet();
    const doneCount  = results.filter(r => r.status === 'done').length;
    const failCount  = results.filter(r => r.status === 'failed').length;
    addLog(`✅ All done! ${doneCount} unsubscribed, ${failCount} failed.`, 'ok');
    renderBody();
  }

  function updateChannelStatus(id, status) {
    const ch = state.channels.find(c => c.id === id);
    if (ch) ch.status = status;
  }

  // ─── Resume after page navigation ─────────────────────────────────────────────
  async function maybeResumeQueue() {
    const q = queueGet();
    if (!q || q.index >= q.items.length) return false;

    // Restore UI state from persisted queue + results
    const results   = resultsGet();
    const resultMap = Object.fromEntries(results.map(r => [r.id, r.status]));

    state.running  = true;
    state.paused   = false;
    state.delay    = q.delay || state.delay;
    state.progress = { done: q.index, total: q.items.length };
    state.channels = q.items.map(item => ({
      id: item.id, name: item.name, url: item.url, avatar: item.avatar || '',
      status: resultMap[item.id] || null,
    }));
    q.items.slice(q.index).forEach(item => state.selected.add(item.id));

    const ch = q.items[q.index];
    addLog(`Resumed at ${q.index + 1}/${q.items.length}: ${ch.name}`, 'info');

    // Wait for page to fully load, then unsubscribe
    await sleep(1000);
    let success = false;
    try {
      success = await performUnsubscribeOnPage();
    } catch (e) {
      addLog(`✗ Error: ${e.message}`, 'err');
    }

    const status = success ? 'done' : 'failed';
    resultsAdd({ id: ch.id, name: ch.name, status });
    updateChannelStatus(ch.id, status);

    if (success) {
      state.selected.delete(ch.id);
      addLog(`✓ Unsubscribed from ${ch.name}`, 'ok');
    } else {
      addLog(`✗ Failed: ${ch.name}`, 'err');
    }

    state.progress.done = q.index + 1;
    q.index++;
    queueSet(q);
    renderBody();

    // Check if we're done
    if (q.index >= q.items.length) {
      finishRun();
      return true;
    }

    // Delay before next navigation
    const d = rand(state.delay - 400, state.delay + 600);
    addLog(`Waiting ${(d / 1000).toFixed(1)}s…`, 'info');
    await sleep(d);

    // Navigate to next channel (this kills the JS context again)
    const nextCh = q.items[q.index];
    if (nextCh && nextCh.url && state.running) {
      addLog(`[${q.index + 1}/${q.items.length}] Going to ${nextCh.name}…`, 'info');
      window.location.href = nextCh.url;
    } else {
      finishRun();
    }

    return true;
  }

  function togglePause() {
    state.paused = !state.paused;
    addLog(state.paused ? '⏸ Paused. Will stop after current channel.' : '▶ Resumed.', 'info');
    renderBody();
  }

  function stopRun() {
    state.running = false;
    state.paused  = false;
    queueClear();
    addLog('■ Stopped by user.', 'info');
    renderBody();
  }

  function invertSelection() {
    state.channels
      .filter(ch => ch.name.toLowerCase().includes(state.filterText.toLowerCase()))
      .forEach(ch => {
        if (state.selected.has(ch.id)) state.selected.delete(ch.id);
        else state.selected.add(ch.id);
      });
    renderBody();
  }

  function scanChannels() {
    addLog('Scanning page for subscriptions…', 'info');
    const found = scrapeChannels();
    const existingMap = Object.fromEntries(state.channels.map(c => [c.id, c]));
    state.channels = found.map(c => ({ ...c, status: existingMap[c.id]?.status ?? null }));
    if (state.channels.length === 0) {
      addLog('No channels found. Go to youtube.com/feed/channels first.', 'err');
    } else {
      addLog(`Found ${state.channels.length} channel(s).`, 'ok');
    }
    renderBody();
  }

  // ─── UI ───────────────────────────────────────────────────────────────────────
  let currentTab = 'channels';
  let panel = null;

  function ensurePanel() {
    if (!document.getElementById('ytus-backdrop')) {
      const bd = document.createElement('div');
      bd.id = 'ytus-backdrop';
      bd.addEventListener('click', closePanel);
      document.body.appendChild(bd);
    }
    if (document.getElementById(PANEL_ID)) { panel = document.getElementById(PANEL_ID); return; }

    panel = document.createElement('div');
    panel.id = PANEL_ID;
    panel.innerHTML = `
      <div class="ytus-header">
        <div class="ytus-header-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ff0000"
               stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42A2.78 2.78 0 0020.83 4.7C19.24 4.27 12 4.27 12 4.27
                     s-7.24 0-8.83.43A2.78 2.78 0 001.46 6.42 29 29 0 001 12a29 29 0
                     00.46 5.58A2.78 2.78 0 003.17 19.3C4.76 19.73 12 19.73 12 19.73
                     s7.24 0 8.83-.43a2.78 2.78 0 001.71-1.72A29 29 0 0023 12a29 29
                     0 00-.46-5.58z"/>
            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
          </svg>
          YouTube Unsubscriber
          <span class="ytus-pill">v3.0</span>
        </div>
        <button class="ytus-close" id="ytus-close-btn" title="Close">✕</button>
      </div>
      <div class="ytus-tabs">
        <button class="ytus-tab active" data-tab="channels">Channels</button>
        <button class="ytus-tab" data-tab="log">Log</button>
        <button class="ytus-tab" data-tab="settings">Settings</button>
      </div>
      <div class="ytus-body" id="ytus-body"></div>
      <div class="ytus-footer" id="ytus-footer"></div>
    `;
    document.body.appendChild(panel);

    panel.querySelector('#ytus-close-btn').addEventListener('click', closePanel);
    panel.querySelectorAll('.ytus-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        currentTab = tab.dataset.tab;
        panel.querySelectorAll('.ytus-tab').forEach(t => t.classList.toggle('active', t === tab));
        renderBody();
      });
    });
  }

  function renderBody() {
    const body   = document.getElementById('ytus-body');
    const footer = document.getElementById('ytus-footer');
    if (!body || !footer) return;
    if      (currentTab === 'channels') renderChannelsTab(body, footer);
    else if (currentTab === 'log')      renderLogTab(body, footer);
    else if (currentTab === 'settings') renderSettingsTab(body, footer);
  }

  function renderChannelsTab(body, footer) {
    const filtered = state.channels.filter(ch =>
      ch.name.toLowerCase().includes(state.filterText.toLowerCase())
    );

    const runningBanner = state.running ? `
      <div class="ytus-running-banner">
        <div class="ytus-spinner"></div>
        Unsubscribing ${state.progress.done} of ${state.progress.total} — keep this tab open
      </div>` : '';

    body.innerHTML = `
      ${runningBanner}
      <div class="ytus-toolbar">
        <input class="ytus-search" id="ytus-search"
               placeholder="Search channels…" value="${escHtml(state.filterText)}">
        <button class="ytus-btn" id="ytus-scan" ${state.running ? 'disabled' : ''}>↻ Scan</button>
        <button class="ytus-btn" id="ytus-selall" ${state.running ? 'disabled' : ''}>All</button>
        <button class="ytus-btn" id="ytus-selnone" ${state.running ? 'disabled' : ''}>None</button>
      </div>
      ${filtered.length === 0 ? `
        <div class="ytus-empty">
          <div class="ytus-empty-icon">📭</div>
          <div class="ytus-empty-title">
            ${state.channels.length === 0 ? 'No channels scanned yet' : 'No channels match'}
          </div>
          <div class="ytus-empty-sub">
            ${state.channels.length === 0
              ? 'Go to <a href="https://www.youtube.com/feed/channels">youtube.com/feed/channels</a>,<br>scroll down to load all channels, then click <strong>↻ Scan</strong>.'
              : 'Try a different search term.'}
          </div>
        </div>
      ` : `
        <ul class="ytus-channel-list" id="ytus-list">
          ${filtered.map(ch => channelItemHTML(ch)).join('')}
        </ul>
      `}
    `;

    const total = state.selected.size;
    if (state.running) {
      const pct = state.progress.total > 0
        ? Math.round((state.progress.done / state.progress.total) * 100) : 0;
      footer.innerHTML = `
        <span class="ytus-progress-label">${state.progress.done}/${state.progress.total}</span>
        <div class="ytus-progress-wrap">
          <div class="ytus-progress-bar" style="width:${pct}%"></div>
        </div>
        <button class="ytus-btn" id="ytus-pause">
          ${state.paused ? '▶ Resume' : '⏸ Pause'}
        </button>
        <button class="ytus-btn danger" id="ytus-stop">■ Stop</button>
      `;
      footer.querySelector('#ytus-pause').addEventListener('click', togglePause);
      footer.querySelector('#ytus-stop').addEventListener('click', stopRun);
    } else {
      footer.innerHTML = `
        <span class="ytus-sel-count">
          <strong>${total}</strong> channel${total !== 1 ? 's' : ''} selected
        </span>
        <button class="ytus-btn" id="ytus-invert">Invert</button>
        <button class="ytus-btn primary" id="ytus-run" ${total === 0 ? 'disabled' : ''}>
          Unsubscribe${total > 0 ? ' ' + total : ''} →
        </button>
      `;
      footer.querySelector('#ytus-invert')?.addEventListener('click', invertSelection);
      footer.querySelector('#ytus-run')?.addEventListener('click', runUnsubscribe);
    }

    body.querySelector('#ytus-search')?.addEventListener('input', e => {
      state.filterText = e.target.value;
      renderBody();
    });
    body.querySelector('#ytus-scan')?.addEventListener('click', scanChannels);
    body.querySelector('#ytus-selall')?.addEventListener('click', () => {
      filtered.forEach(ch => state.selected.add(ch.id));
      renderBody();
    });
    body.querySelector('#ytus-selnone')?.addEventListener('click', () => {
      filtered.forEach(ch => state.selected.delete(ch.id));
      renderBody();
    });
    body.querySelectorAll('.ytus-channel-item').forEach(item => {
      item.addEventListener('click', () => {
        if (state.running) return;
        const id = item.dataset.id;
        if (state.selected.has(id)) state.selected.delete(id);
        else state.selected.add(id);
        item.classList.toggle('selected', state.selected.has(id));
        updateFooterCount();
      });
    });
  }

  function channelItemHTML(ch) {
    const sel     = state.selected.has(ch.id);
    const initial = ch.name.charAt(0).toUpperCase();
    const avatar  = ch.avatar
      ? `<img class="ytus-avatar" src="${escHtml(ch.avatar)}" alt="" onerror="this.style.display='none'">`
      : `<div class="ytus-avatar-ph">${initial}</div>`;
    const badge = ch.status === 'done'
      ? '<span class="ytus-status-badge done">✓ Done</span>'
      : ch.status === 'failed'
      ? '<span class="ytus-status-badge failed">✗ Failed</span>'
      : '';
    return `
      <li class="ytus-channel-item${sel ? ' selected' : ''}${ch.status ? ' ' + ch.status : ''}"
          data-id="${escHtml(ch.id)}">
        <div class="ytus-checkbox"><span class="ytus-checkbox-tick">✓</span></div>
        ${avatar}
        <div class="ytus-channel-info">
          <div class="ytus-channel-name">${escHtml(ch.name)}</div>
          <div class="ytus-channel-sub">${escHtml(safePathname(ch.url))}</div>
        </div>
        ${badge}
      </li>`;
  }

  function updateFooterCount() {
    const el = document.querySelector('.ytus-sel-count strong');
    if (el) el.textContent = state.selected.size;
    const runBtn = document.getElementById('ytus-run');
    if (runBtn) {
      runBtn.disabled = state.selected.size === 0;
      runBtn.textContent = `Unsubscribe${state.selected.size > 0 ? ' ' + state.selected.size : ''} →`;
    }
  }

  function renderLogTab(body, footer) {
    body.innerHTML = `<div class="ytus-log-wrap" id="ytus-log-inner">
      ${state.log.length === 0
        ? '<div style="color:#555;text-align:center;padding:40px 0">No log entries yet.</div>'
        : state.log.map(e =>
            `<div class="ytus-log-entry ${e.type}">[${e.ts}] ${escHtml(e.msg)}</div>`
          ).join('')
      }
    </div>`;
    footer.innerHTML = `<button class="ytus-btn" id="ytus-clearlog">Clear log</button>`;
    footer.querySelector('#ytus-clearlog').addEventListener('click', () => {
      state.log = [];
      renderBody();
    });
  }

  function renderLog() {
    if (currentTab !== 'log') return;
    const el = document.getElementById('ytus-log-inner');
    if (el) el.innerHTML = state.log.map(e =>
      `<div class="ytus-log-entry ${e.type}">[${e.ts}] ${escHtml(e.msg)}</div>`
    ).join('');
  }

  function renderSettingsTab(body, footer) {
    body.innerHTML = `
      <div class="ytus-settings-section">
        <div class="ytus-settings-label">Automation</div>
        <div class="ytus-settings-row">
          <label>Delay between unsubscribes</label>
          <input type="range" class="ytus-range" id="ytus-delay"
                 min="1000" max="6000" step="100" value="${state.delay}">
          <span class="ytus-range-val" id="ytus-delay-val">
            ${(state.delay / 1000).toFixed(1)}s
          </span>
        </div>
      </div>
      <div class="ytus-info-box">
        <strong>How to use</strong><br>
        1. Go to <a href="https://www.youtube.com/feed/channels">youtube.com/feed/channels</a>
           and scroll down to load all channels<br>
        2. Click <strong>↻ Scan</strong><br>
        3. Select the channels you want to remove<br>
        4. Click <strong>Unsubscribe →</strong><br><br>
        The script navigates to each channel, clicks Subscribed → Unsubscribe, confirms,
        then moves on automatically. Keep this tab open — do not navigate away.<br><br>
        <strong>Delay ≥ 2 s</strong> recommended to avoid rate-limiting.
      </div>
    `;
    footer.innerHTML = `<span class="ytus-sel-count" style="color:#555">Settings auto-save</span>`;
    body.querySelector('#ytus-delay').addEventListener('input', e => {
      state.delay = parseInt(e.target.value);
      body.querySelector('#ytus-delay-val').textContent = (state.delay / 1000).toFixed(1) + 's';
      _gmSet('delay', state.delay);
    });
  }

  // ─── Open / Close ─────────────────────────────────────────────────────────────
  function openPanel() {
    ensurePanel();
    document.getElementById('ytus-backdrop').classList.add('ytus-open');
    panel.classList.add('ytus-open');
    currentTab = 'channels';
    panel.querySelectorAll('.ytus-tab').forEach(t =>
      t.classList.toggle('active', t.dataset.tab === 'channels')
    );
    if (state.channels.length === 0 && !state.running) scanChannels();
    else renderBody();
  }

  function closePanel() {
    document.getElementById('ytus-backdrop')?.classList.remove('ytus-open');
    document.getElementById(PANEL_ID)?.classList.remove('ytus-open');
  }

  // ─── FAB ──────────────────────────────────────────────────────────────────────
  function createFAB() {
    if (document.getElementById('ytus-fab')) return;
    const fab = document.createElement('button');
    fab.id    = 'ytus-fab';
    fab.title = 'YouTube Bulk Unsubscriber (Alt+U)';
    fab.innerHTML = `
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="3 6 5 6 21 6"/>
        <path d="M19 6l-1 14H6L5 6"/>
        <path d="M10 11v6M14 11v6"/>
        <path d="M9 6V4h6v2"/>
      </svg>`;
    fab.addEventListener('click', openPanel);
    document.body.appendChild(fab);
  }

  // ─── Keyboard shortcut Alt+U ──────────────────────────────────────────────────
  document.addEventListener('keydown', e => {
    if (e.altKey && e.key === 'u') {
      const p = document.getElementById(PANEL_ID);
      if (!p || !p.classList.contains('ytus-open')) openPanel();
      else closePanel();
    }
  });

  // ─── Init ─────────────────────────────────────────────────────────────────────
  async function init() {
    createFAB();

    const q = queueGet();
    if (q && q.index < q.items.length) {
      // We were mid-run — resume automatically
      const resumed = await maybeResumeQueue();
      if (resumed) {
        ensurePanel();
        // Auto-open to show progress
        document.getElementById('ytus-backdrop').classList.add('ytus-open');
        panel.classList.add('ytus-open');
        renderBody();
      }
    } else {
      addLog('YouTube Unsubscriber ready. Press Alt+U or click the red ▣ button.', 'info');
    }
  }

  if (document.body) {
    init();
  } else {
    document.addEventListener('DOMContentLoaded', init);
  }

  // Recreate FAB after SPA navigations
  let lastUrl = location.href;
  new MutationObserver(() => {
    if (location.href !== lastUrl) {
      lastUrl = location.href;
      setTimeout(createFAB, 1500);
    }
  }).observe(document.body, { childList: true, subtree: true });

})();
